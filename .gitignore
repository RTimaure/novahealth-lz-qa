# Local .terraform directories
**/.terraform/*

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files, which may contain sensitive data
*.tfvars
*.tfvars.json

# Local backend config (env-specific, not secret but excluded to avoid drift
# between developers). Copy the committed backend.hcl.example instead.
backend.hcl

# Override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# CLI configuration files
.terraformrc
terraform.rc

# Exclude Terraform plan output files, which can contain sensitive data, such as provider
*.tfplan
# exclude data sources
source/

# Exclude Terraform plan output files, which can contain sensitive data, such as provider
*.plan

# Exclude Terraform lock files, which can contain sensitive data, such as provider
*.lock.hcl
.terraform.lock.hcl